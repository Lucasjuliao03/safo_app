# =============================================================
# Variáveis de Ambiente — SAFO / Concurseiro Gil
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env no repositório.
# =============================================================

# ─── Frontend (expostas ao browser — VITE_ prefix) ───────────
# Obtidas em: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# ─── Backend / Vercel Functions ───────────────────────────────
# URL pública da sua aplicação na Vercel (sem barra no final)
APP_URL=https://safo-app.vercel.app

# Somente para desenvolvimento local
DEV_APP_URL=http://localhost:8080
DEV_API_PORT=3000

# Supabase Service Role (bypassa RLS — somente no backend!)
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Mercado Pago Access Token DE PRODUÇÃO (NUNCA exponha no frontend)
# Obtido em: mercadopago.com.br → Developers → Credenciais
MERCADO_PAGO_ACCESS_TOKEN=your-server-only-access-token

# Obrigatório antes de cobrar: assinatura da MESMA aplicação das credenciais.
# Mercado Pago Developers → Sua integração → Webhooks → assinatura secreta.
MERCADO_PAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID numérico da conta vendedora, não o ID da aplicação.
# node scripts/check-payments.mjs --live consulta /users/me sem criar cobranças.
MERCADO_PAGO_COLLECTOR_ID=000000000

# Produção exige true. Credenciais/assinatura/recebedor precisam corresponder.
# Para homologação isolada use false + conta de teste e uma URL HTTPS pública.
MERCADO_PAGO_LIVE_MODE=true

# Edge Functions / pg_cron (mesmo valor forte nos dois ambientes)
CRON_SECRET=gere-um-segredo-aleatorio-com-32-ou-mais-bytes

# Também configure APP_URL, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY e VAPID_SUBJECT
# no ambiente das Supabase Edge Functions.

# =============================================================
# Variáveis de Ambiente — SAFO / Concurseiro Gil
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env no repositório.
# =============================================================

# ─── Frontend (expostas ao browser — VITE_ prefix) ───────────
# Obtidas em: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Backend / Vercel Functions ───────────────────────────────
# URL pública da sua aplicação na Vercel (sem barra no final)
APP_URL=https://seu-app.vercel.app

# Supabase Service Role (bypassa RLS — somente no backend!)
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Mercado Pago Access Token (NUNCA exponha no frontend)
# Obtido em: mercadopago.com.br → Developers → Credenciais
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000
